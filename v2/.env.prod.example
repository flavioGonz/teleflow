# ─── HznFlow v2 — PROD env template ───────────────────────────────────────────
# Copiá a .env.prod y completá. NO commitees .env.prod.
#
# Diferencias clave con dev:
#  - JWT_SECRET es OBLIGATORIO (no hay default seguro)
#  - DATABASE_URL apunta a Postgres managed externo (Supabase/Neon/RDS/etc)
#  - CORS_ORIGIN debe ser el dominio real de la app
#  - Todas las credenciales son OBLIGATORIAS

# ── App ──────────────────────────────────────────────────────────
NODE_ENV=production
# Dominio público desde donde corre el frontend (para CORS)
CORS_ORIGIN=https://hznflow.horizon.com.uy

# ── JWT (CRÍTICO) ────────────────────────────────────────────────
# Generá uno largo y random: `openssl rand -base64 64`
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── PostgreSQL managed externo ───────────────────────────────────
# Connection string completa al Postgres de producción.
# Ej Supabase: postgres://user:pass@db.xxx.supabase.co:5432/postgres
# Ej Neon:     postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/hznflow
# Ej RDS:      postgres://hznflow:pass@hznflow.xxx.rds.amazonaws.com:5432/hznflow
DATABASE_URL=

# ── MySQL Asterisk (red Horizon) ────────────────────────────────
ASTERISK_DB_HOST=10.1.1.7
ASTERISK_DB_PORT=3306
ASTERISK_DB_USER=tfremote
ASTERISK_DB_PASS=
ASTERISK_DB_NAME=asterisk
CDR_DB_NAME=asteriskcdrdb

# ── Asterisk Manager Interface ──────────────────────────────────
AMI_HOST=10.1.1.7
AMI_PORT=5038
AMI_USER=teleflow
AMI_PASS=

# ── Puertos públicos (defaults razonables) ──────────────────────
FRONTEND_PUBLIC_PORT=443
BACKEND_PUBLIC_PORT=4000
REALTIME_PUBLIC_PORT=3001
