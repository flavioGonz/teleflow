# Dev — tsx watch + Prisma client generado.
# El código fuente se monta como volumen desde host.
FROM node:22-alpine
WORKDIR /app

# Compilación de better-sqlite3 puede necesitar build tools
RUN apk add --no-cache python3 make g++

COPY package.json package-lock.json* ./
RUN npm ci

COPY prisma ./prisma
RUN npx prisma generate

EXPOSE 4000
# Command se setea desde docker-compose.dev.yml
CMD ["npx", "tsx", "watch", "src/index.ts"]
