# Override de credenciales para docker compose.
# Copiá a .env y completá. Si no existe, docker compose usa los defaults del compose file.

JWT_SECRET=cambiame-en-prod-genera-uno-largo-y-random

# MySQL Asterisk remoto
ASTERISK_DB_HOST=10.1.1.7
ASTERISK_DB_PORT=3306
ASTERISK_DB_USER=tfremote
ASTERISK_DB_PASS=
ASTERISK_DB_NAME=asterisk
CDR_DB_NAME=asteriskcdrdb

# Asterisk Manager Interface
AMI_HOST=10.1.1.7
AMI_PORT=5038
